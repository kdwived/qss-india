# ============================================================================
# QSS India website — environment variables
# Copy this file to .env.local and fill in only what you're ready to use.
# Every value below is OPTIONAL — the site works with all of them blank.
# Never commit .env.local (it's already in .gitignore).
# ============================================================================

# Your real production domain. Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph tags. See src/config/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Google Search Console → Settings → Ownership verification → HTML tag
# → paste only the content="..." value. See src/config/site.ts.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (starts with G-). See src/config/analytics.ts.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID (starts with GTM-). See src/config/analytics.ts.
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID. See src/config/analytics.ts.
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag partner ID. See src/config/analytics.ts.
NEXT_PUBLIC_LINKEDIN_INSIGHT_ID=

# Google Ads conversion ID (starts with AW-). See src/config/analytics.ts.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Where the Quote popup and the /contact page form submit leads to —
# a Formspree/Getform endpoint, a custom API route, or a Zapier/CRM
# webhook URL. Leave blank to keep the current local-only demo behavior.
# See src/config/contact.ts.
NEXT_PUBLIC_LEAD_FORM_ENDPOINT=
